# Copy to .env.local and fill. NEVER commit a filled copy.

# ── Neon Postgres ────────────────────────────────────────────────
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/atlas?sslmode=require"
# Direct connection — used by the migration runner (src/infra/db/migrate.ts) only.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/atlas?sslmode=require"

# ── SQL sandbox for QUERY missions (M2 task e, ADR-018) ──────────
# A disposable Neon branch per mission session, dropped afterwards.
# Without these, QUERY missions refuse to run rather than falling back
# to the primary branch.
NEON_API_KEY=""                 # console.neon.tech -> Account -> API keys
NEON_PROJECT_ID=""             # SELECT current_setting('neon.project_id')

# ── Auth (M0 task 4) ─────────────────────────────────────────────
BETTER_AUTH_SECRET=""          # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# ── Private vault (M1) ───────────────────────────────────────────
# AES-256-GCM key for compensation data. Never logged, never sent to a model.
VAULT_KEY=""                   # openssl rand -base64 32

# ── AI providers ─────────────────────────────────────────────────
# Not required until M3. Server-side only — never exposed to the client.
# ANTHROPIC_API_KEY=""

# ── Which database is this? (scripts/lib/branch-guard.mjs) ───────
# The migration runner and every seeder read these BEFORE their first write,
# compare them against the live connection's own neon.branch_id, and refuse on
# any disagreement. They are identifiers, not secrets.
#
#   .env.local             ATLAS_DB_ENV="development"  — permanently dev
#   .env.production.local  ATLAS_DB_ENV="production"   — :prod scripts only
#
ATLAS_DB_ENV="development"
# REQUIRED in every environment. The one branch this file may write to; a blank
# value refuses every write, everywhere. Find it with: npm run db:where
ATLAS_DB_BRANCH_ID="br-REPLACE-ME"
#
# DATABASE_URL and DATABASE_URL_UNPOOLED must resolve to the same Neon endpoint
# (the pooled host is the direct one plus "-pooler"). They are checked against
# each other before any write, and inside getDb() before any query: the guard
# used to inspect only the unpooled URL, while the app writes through the
# pooled one.
# Development files only: an independent deny-list. If a connection from a
# non-production env file lands on this branch, the write is refused whatever
# else the file claims.
ATLAS_PROD_BRANCH_ID=""
