# Copy to .env.local and fill. NEVER commit a filled copy.

# ── Neon Postgres ────────────────────────────────────────────────
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/atlas?sslmode=require"
# Direct connection — used by the migration runner (src/infra/db/migrate.ts) only.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/atlas?sslmode=require"

# ── SQL sandbox for QUERY missions (M2 task e, ADR-018) ──────────
# A disposable Neon branch per mission session, dropped afterwards.
# Without these, QUERY missions refuse to run rather than falling back
# to the primary branch.
NEON_API_KEY=""                 # console.neon.tech -> Account -> API keys
NEON_PROJECT_ID=""             # SELECT current_setting('neon.project_id')

# ── Auth (M0 task 4) ─────────────────────────────────────────────
BETTER_AUTH_SECRET=""          # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# ── Private vault (M1) ───────────────────────────────────────────
# AES-256-GCM key for compensation data. Never logged, never sent to a model.
VAULT_KEY=""                   # openssl rand -base64 32

# ── AI providers ─────────────────────────────────────────────────
# Not required until M3. Server-side only — never exposed to the client.
# ANTHROPIC_API_KEY=""
